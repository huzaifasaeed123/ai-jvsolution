# ---- Backend (NestJS) environment ----
# Copy to .env and fill values. Never commit real secrets.

# App
NODE_ENV=development
PORT=4000
API_PREFIX=api

# Database (PostgreSQL) — used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jvsolution?schema=public"

# Auth / JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — allowed web origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# File storage (Data Room). Driver: "local" (dev) or "s3" (prod).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.storage

# S3-compatible (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI natural-language layer. "template" = deterministic, no external calls (default).
# Later: "anthropic" (needs ANTHROPIC_API_KEY) or "local" (self-hosted model).
AI_PROVIDER=template

# AI (Phase 4) — chatbot/avatar
ANTHROPIC_API_KEY=

# Payments (Phase 2+)
STRIPE_SECRET_KEY=

# ---- Google sign-in ----
# From the Google Cloud console, OAuth client of type "Web application".
# Leave both blank to disable the feature: the button is then hidden rather
# than shown and broken.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The public origin the browser is on. Same variable the frontend uses, set on
# this service too, because the backend is what builds the callback URL sent to
# Google. In production this is required — there is no localhost fallback, and
# the app refuses to start rather than sending real users to a dev machine.
# The resulting URI is <origin>/api/auth/callback/google and must be registered
# in the console verbatim.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only if the callback lives somewhere the origin cannot derive.
# GOOGLE_REDIRECT_URI=
