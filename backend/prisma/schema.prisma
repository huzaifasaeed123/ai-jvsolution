// Prisma schema — JV Solution
// Datasource URL comes from DATABASE_URL env var: local Postgres in dev,
// server Postgres in production. Change the env var only — never the code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  OWNER
  DEVELOPER
  INVESTOR
  GOVERNMENT
  ADMIN
}

enum AccessLevel {
  PUBLIC
  REGISTERED
  VERIFIED
  NDA
  DUE_DILIGENCE
  TRANSACTION
}

// Public / semi-government / government owner category (spec §3, §30).
enum OwnerCategory {
  PRIVATE
  SEMI_GOVERNMENT
  GOVERNMENT
}

// Opportunity lifecycle (spec §36).
enum OpportunityStatus {
  DRAFT
  PUBLISHED
  MATCHED
  IN_DEAL
  CLOSED
  ARCHIVED
}

// Opportunity Passport verification tiers (spec §23).
enum VerificationTier {
  T0 // Draft / unverified
  T1 // Declared information
  T2 // Documents reviewed
  T3 // Ownership / authority verified
  T4 // Professional due diligence verified
  T5 // Registry / authority linked / independently validated
}

enum RiskLevel {
  LOW
  MODERATE
  MEDIUM
  HIGH
}

enum PermitStatus {
  NONE
  PRELIMINARY
  IN_PROGRESS
  APPROVED
}

enum DataRoomReadiness {
  EMPTY
  BASIC
  PARTIAL
  COMPLETE
}

// Access request lifecycle (spec §24 anonymous reveal protocol).
enum AccessStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

// Offer / EOI lifecycle (spec §25, §36).
enum OfferType {
  EOI
  OFFER
}

enum OfferStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// Due Diligence Centre (spec §11).
enum RiskRating {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

enum ReceiptStatus {
  NOT_RECEIVED
  RECEIVED
  NOT_APPLICABLE
}

enum DdReviewStatus {
  PENDING
  IN_REVIEW
  REVIEWED
}

enum ClosureStatus {
  OPEN
  CLOSED
}

// ============================================================
// Identity & organisation
// ============================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  country   String?
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  fullName     String
  role         Role
  accessLevel  AccessLevel   @default(REGISTERED)
  country      String?
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id])
  opportunities Opportunity[]
  mandates     Mandate[]
  accessRequests AccessRequest[] @relation("AccessRequester")
  offers       Offer[]         @relation("OfferSubmitter")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([role])
}

// ============================================================
// Opportunities (core domain)
// Public fields are safe to list; confidential fields are only serialized
// to the owner/admin (and, from Step 5, users granted access). See serializer.
// ============================================================

model Opportunity {
  id        String @id @default(cuid())
  reference String @unique // human-friendly, e.g. JV-AE-2026-0007

  // --- Identity (public) ---
  title         String
  summary       String? // short public description
  sector        String // validated against reference SECTORS
  projectType   String? // validated against reference PROJECT_TYPES
  ownerCategory OwnerCategory @default(PRIVATE)

  status       OpportunityStatus @default(DRAFT)
  verification VerificationTier  @default(T0)

  // --- Location ---
  countryCode String // public
  region      String? // public
  city        String? // public
  addressLine String? // CONFIDENTIAL
  latitude    Float? // CONFIDENTIAL
  longitude   Float? // CONFIDENTIAL

  // --- Physical / planning (public) ---
  landAreaSqm Float?
  gfaSqm      Float?
  buaSqm      Float?
  nsaSqm      Float?
  plotRatio   Float?
  landUse     String?
  heightLimit String?

  // --- Commercial (public, indicative) ---
  currency              String  @default("USD")
  projectValueCents     BigInt? // GDV, minor units
  investmentRequiredCents BigInt?
  targetIrr             Float? // %
  developmentPeriodMonths Int?
  concessionPeriodYears Int?

  // --- Structure & risk ---
  structures        String[] // validated against reference STRUCTURES
  riskLevel         RiskLevel?
  permitStatus      PermitStatus      @default(NONE)
  dataRoomReadiness DataRoomReadiness @default(EMPTY)

  // --- Partner requirements (public) ---
  requiredDeveloperExperience String?
  requiredContractorClass     String?
  requiredOperatorType        String?
  financingRequired           Boolean @default(false)

  // --- Ownership (identity CONFIDENTIAL until reveal) ---
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  accessRequests    AccessRequest[]
  folders           Folder[]
  documents         Document[]
  dueDiligenceItems DueDiligenceItem[]
  verificationRecord VerificationRecord?
  feasibilityRuns   FeasibilityRun[]
  valuationRuns     ValuationRun[]
  estimateRuns      EstimateRun[]
  offers            Offer[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([status])
  @@index([countryCode])
  @@index([sector])
  @@index([ownerId])
}

// ============================================================
// Mandates (developer / investor demand side)
// What a capital/delivery partner is looking for. Matched against
// opportunities by the deterministic Fit Score engine.
// ============================================================

model Mandate {
  id    String @id @default(cuid())
  title String

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  // Targeting criteria (validated string codes / enums)
  sectors         String[]
  countryCodes    String[]
  projectTypes    String[]
  structures      String[]
  ownerCategories OwnerCategory[]

  // Ticket size (minor units)
  currency           String  @default("USD")
  minInvestmentCents BigInt?
  maxInvestmentCents BigInt?

  targetIrr    Float? // % the partner is targeting
  riskAppetite RiskLevel?

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([active])
}

// ============================================================
// Access requests, NDA & reveal (spec §24) + audit trail
// ============================================================

model AccessRequest {
  id            String       @id @default(cuid())
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id])
  requesterId   String
  requester     User         @relation("AccessRequester", fields: [requesterId], references: [id])
  ownerId       String // denormalized opportunity owner (fast owner-side queries)
  status        AccessStatus @default(PENDING)
  message       String?
  ndaSignedAt   DateTime? // reveal requires APPROVED + ndaSignedAt
  decidedAt     DateTime?
  decidedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([opportunityId, requesterId]) // one request per user per opportunity
  @@index([ownerId])
  @@index([requesterId])
  @@index([opportunityId])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  action        String // ACCESS_REQUESTED, ACCESS_APPROVED, ACCESS_REJECTED, NDA_SIGNED, CONFIDENTIAL_VIEWED, DOCUMENT_VIEWED, DOCUMENT_DOWNLOADED, DOCUMENT_UPLOADED
  opportunityId String?
  targetUserId  String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([opportunityId])
  @@index([actorId])
}

// ============================================================
// Secure Data Room (spec §10, §24, §27)
// A permission-controlled document vault per opportunity. Files are streamed
// through the API (never public URLs) so every access is authorized + audited.
// minAccessLevel gates who can see a folder/document: PUBLIC/REGISTERED are
// broadly visible; NDA (default) requires an approved + NDA-signed access grant.
// ============================================================

model Folder {
  id             String       @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id])
  parentId       String?
  parent         Folder?      @relation("FolderTree", fields: [parentId], references: [id])
  children       Folder[]     @relation("FolderTree")
  code           String? // e.g. "01" for the standard section index
  name           String
  order          Int          @default(0)
  minAccessLevel AccessLevel  @default(NDA)
  documents      Document[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([opportunityId])
  @@index([parentId])
}

model Document {
  id             String            @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity       @relation(fields: [opportunityId], references: [id])
  folderId       String
  folder         Folder            @relation(fields: [folderId], references: [id])
  name           String
  minAccessLevel AccessLevel? // overrides the folder level when set
  createdById    String
  versions       DocumentVersion[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([opportunityId])
  @@index([folderId])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  version      Int
  storageKey   String // path/key within the storage driver
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

// ============================================================
// Due Diligence Centre (spec §11)
// A per-opportunity checklist. Each item carries receipt, review status, risk
// rating, finding, mitigation, deadline and closure.
// ============================================================

// AI Feasibility run (spec §7, §42). Stores inputs + formula version +
// assumptions + outputs so every result is reproducible and auditable.
model FeasibilityRun {
  id             String       @id @default(cuid())
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  createdById    String
  label          String?
  formulaVersion String
  inputs         Json
  assumptions    Json
  outputs        Json
  createdAt      DateTime     @default(now())

  @@index([createdById])
  @@index([opportunityId])
}

// Offer / EOI on an opportunity (spec §25). Structured terms feed the
// weighted comparison engine (Step 2).
model Offer {
  id                   String      @id @default(cuid())
  opportunityId        String
  opportunity          Opportunity @relation(fields: [opportunityId], references: [id])
  submittedById        String
  submittedBy          User        @relation("OfferSubmitter", fields: [submittedById], references: [id])
  ownerId              String // denormalized opportunity owner
  type                 OfferType   @default(OFFER)
  status               OfferStatus @default(SUBMITTED)
  structure            String? // proposed JV structure code
  currency             String      @default("USD")
  investmentAmountCents BigInt? // capital offered
  ownerSharePct        Float? // return offered to the owner (%)
  targetIrr            Float?
  developmentMonths    Int?
  experienceYears      Int?
  financialCapacityCents BigInt?
  guarantees           String?
  message              String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt           DateTime?

  @@unique([opportunityId, submittedById]) // one active offer per user per opportunity
  @@index([ownerId])
  @@index([submittedById])
  @@index([opportunityId])
}

// AI Estimate run (spec §8, §42). Stores inputs + formula version + outputs.
model EstimateRun {
  id             String       @id @default(cuid())
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  createdById    String
  label          String?
  formulaVersion String
  inputs         Json
  outputs        Json
  createdAt      DateTime     @default(now())

  @@index([createdById])
  @@index([opportunityId])
}

// AI Valuation run (spec §9, §42). Stores method + inputs + assumptions + outputs.
model ValuationRun {
  id             String       @id @default(cuid())
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  createdById    String
  method         String
  label          String?
  formulaVersion String
  inputs         Json
  assumptions    Json
  outputs        Json
  createdAt      DateTime     @default(now())

  @@index([createdById])
  @@index([opportunityId])
}

// Opportunity Passport verification (spec §23). Tier lives on Opportunity;
// this record holds the verified fields, unresolved items, reviewer and date.
model VerificationRecord {
  id              String      @id @default(cuid())
  opportunityId   String      @unique
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  verifiedFields  String[]
  unresolvedItems String[]
  notes           String?
  reviewerId      String?
  reviewerName    String?
  reviewedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model DueDiligenceItem {
  id               String         @id @default(cuid())
  opportunityId    String
  opportunity      Opportunity    @relation(fields: [opportunityId], references: [id])
  category         String // e.g. "legal", "financial" from the DD categories list
  title            String // the required document / item
  receipt          ReceiptStatus  @default(NOT_RECEIVED)
  reviewStatus     DdReviewStatus @default(PENDING)
  riskRating       RiskRating?
  finding          String?
  recommendation   String?
  responsibleParty String?
  mitigation       String?
  evidence         String?
  deadline         DateTime?
  closure          ClosureStatus  @default(OPEN)
  reviewerId       String?
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  @@index([opportunityId])
  @@index([category])
}
